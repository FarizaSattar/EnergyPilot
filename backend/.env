# ============================================================================
# EnergyPilot
# ============================================================================

APP_NAME=EnergyPilot API
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

DEFAULT_HOME_ID=building-001

# ============================================================================
# PostgreSQL
# ============================================================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/energypilot

DB_HOST=localhost
DB_PORT=5432
DB_NAME=energypilot
DB_USER=postgres
DB_PASSWORD=postgres

DB_POOL_MIN=1
DB_POOL_MAX=10

# ============================================================================
# Flask API
# ============================================================================

API_HOST=127.0.0.1
API_PORT=5000

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# MQTT
# ============================================================================

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60

MQTT_TOPIC=building/+/meter
MQTT_QOS=1

MQTT_CLIENT_ID=energypilot-ingestor

# Leave blank if your local MQTT broker has no authentication.
MQTT_USERNAME=
MQTT_PASSWORD=

MQTT_TLS_ENABLED=false
MQTT_TLS_CA_CERT=

MQTT_STATUS_TOPIC=energypilot/ingestor/status

# ============================================================================
# Application limits
# ============================================================================

DEFAULT_READINGS_LIMIT=500
MAX_READINGS_LIMIT=5000

DEFAULT_HISTORY_HOURS=24
MAX_HISTORY_HOURS=744

MAX_UPLOAD_MB=10
MAX_UPLOAD_ROWS=250000

DEFAULT_FORECAST_DAYS=7
MAX_FORECAST_DAYS=90

DEFAULT_SIMULATION_DAYS=30
MAX_SIMULATION_DAYS=365

TIMEZONE=America/Toronto

DEFAULT_PRICING_PLAN=tou

EXPOSE_INTERNAL_ERRORS=false